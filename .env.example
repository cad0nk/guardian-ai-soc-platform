# Copy this file to ".env" and fill in YOUR OWN keys. Never commit ".env".
# Location: next to guardian_ai_v4_fixed.py (running from source) or next to guardian_ai.exe.
# Every key is optional: a missing key only disables the matching feature.

# Cyber Threat Intelligence
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# Malware analysis enrichment (Hybrid Analysis)
HYBRID_API_KEY=

# AI SOC Analyst + AI summaries (Groq)
GROQ_API_KEY=
# Optional model override. Leave empty to use the built-in default.
GROQ_MODEL=
